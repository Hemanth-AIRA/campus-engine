<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>AIRA - Detailed Interview Report</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', system-ui, sans-serif; background: #fff; padding: 0; font-size: 12px; line-height: 1.4; }
  .report { max-width: 100%; margin: 0; background: #fff; }
  
  /* Header with Logo */
  .header { background: linear-gradient(135deg, #93c5fd 0%, #bfdbfe 100%); padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; }
  .header .title-text { color: #000; font-size: 18px; font-weight: 700; line-height: 1.4; max-width: 60%; }
  .header .title-text .role { font-weight: 800; color: #0f172a; }
  .header .title-text .company { font-weight: 700; color: #1e3a8a; }
  .logo-box { background: #fff; padding: 10px 16px; border-radius: 8px; height: 60px; display: flex; align-items: center; }
  .logo-box img { height: 44px; display: block; }

  /* VERDICT BANNER */
  .verdict-banner { padding: 18px 20px; display: flex; align-items: center; gap: 16px; }
  .verdict-banner.pass { background: linear-gradient(135deg, #059669 0%, #10b981 50%, #34d399 100%); }
  .verdict-banner.fail { background: #fca5a5; padding: 14px 20px; }
  .verdict-badge { width: 56px; height: 56px; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; flex-shrink: 0; color: #fca5a5; }
  .verdict-content { flex: 1; color: #000; }
  .verdict-status { font-size: 20px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
  .verdict-subtitle { font-size: 12px; opacity: 0.9; margin-top: 2px; }
  .verdict-score-box { text-align: center; background: #fff; border-radius: 8px; padding: 8px 12px; }
  .verdict-score-box .number { font-size: 26px; font-weight: 800; color: #fca5a5; }
  .verdict-score-box .label { font-size: 8px; color: #000; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
  
  /* Quick Stats Strip */
  .stats-strip { display: grid; grid-template-columns: 25% 25% 25% 25%; background: #f8fafc; border-bottom: 1px solid #e5e7eb; }
  .stat { padding: 12px 8px; text-align: center; border-right: 1px solid #e5e7eb; }
  .stat:last-child { border-right: none; }
  .stat .value { font-size: 18px; font-weight: 800; color: #1e3a8a; }
  .stat .label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.3px; color: #64748b; margin-top: 2px; }
  
  /* Candidate + Interview Row */
  .info-section { display: grid; grid-template-columns: 50% 50%; border-bottom: 1px solid #e5e7eb; }
  .info-box { padding: 14px 18px 8px 18px ; }
  .info-box:first-child { border-right: 1px solid #e5e7eb; }
  .info-box .title { font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: #1e3a8a; font-weight: 700; margin-bottom: 10px; }
  
  /* Updated Candidate Card Layout */
  .candidate-card { display: flex; gap: 16px; align-items: stretch; }
  .candidate-avatar { 
    width: 200px; 
    height: 200px; 
    min-width: 200px;
    border-radius: 12px; 
    background: linear-gradient(135deg, #1e3a8a, #3b82f6); 
    color: #fff; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    font-size: 72px; 
    font-weight: 700; 
    flex-shrink: 0; 
    overflow: hidden; 
  }
  .candidate-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .candidate-info-wrapper { 
    flex: 1; 
    display: flex; 
    flex-direction: column; 
    gap: 8px;
    min-height: 200px;
    margin-top: 50px;
  }
  .candidate-info-title { 
    font-size: 10px; 
    text-transform: uppercase; 
    letter-spacing: 0.5px; 
    color: #1e3a8a; 
    font-weight: 700; 
    margin-bottom: 8px; 
  }
  .candidate-details { 
    background: #f8fafc; 
    padding: 10px 12px; 
    border-radius: 6px; 
    margin-bottom: 6px;
  }
  .candidate-details .name { font-size: 12px; font-weight: 700; color: #0f172a; margin-bottom: 6px; }
  .candidate-details .email { font-size: 10px; color: #64748b; margin-top: 3px; }
  .candidate-details .phone { font-size: 10px; color: #64748b; margin-top: 3px; }
  .candidate-details .label { font-size: 9px; text-transform: uppercase; color: #94a3b8; font-weight: 600; margin-bottom: 2px; }
  .candidate-details .value { font-size: 11px; font-weight: 600; color: #334155; }
  .candidate-details .position-tag { display: inline-block; background: #e0e7ff; color: #3730a3; padding: 4px 10px; border-radius: 4px; font-size: 10px; font-weight: 600; margin-top: 8px; }
  .company-box { 
    background: linear-gradient(135deg, #f8fafc, #f1f5f9); 
    border: 1px solid #e2e8f0; 
    border-radius: 8px; 
    padding: 10px 12px; 
    margin-top: auto;
  }
  .company-box .company-label { font-size: 9px; text-transform: uppercase; color: #64748b; font-weight: 600; margin-bottom: 3px; }
  .company-box .company-name { font-size: 13px; font-weight: 700; color: #0f172a; display: flex; align-items: center; gap: 6px; }
  
  .interview-grid { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 8px; 
  }
  .interview-cell { 
    background: #f8fafc; 
    padding: 8px 10px; 
    border-radius: 6px; 
  }
  .interview-cell.wide { grid-column: span 2; }
  .interview-cell .value.mono { font-family: monospace; font-size: 10px; }
  .interview-cell.company-position-cell { 
    grid-column: 1 / -1;  /* Span full width - row 1 */
    display: flex; 
    flex-direction: column; 
    gap: 12px; 
  }
  .interview-cell .info-item { 
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .interview-cell .info-item .label { 
    font-size: 9px; 
    text-transform: uppercase; 
    color: #94a3b8; 
    font-weight: 600;
    margin-bottom: 0;
    white-space: nowrap;
  }
  .interview-cell .info-item .value { 
    font-size: 11px; 
    font-weight: 600; 
    color: #334155;
    margin-top: 0;
  }
  
  /* Section styling */
  .section { padding: 14px 18px; border-bottom: 1px solid #e5e7eb; }
  .section-header { font-size: 12px; font-weight: 700; color: #1e3a8a; margin-bottom: 10px; }
  
  /* Analysis Cards - Resume & Interview */
  .analysis-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .analysis-card { background: linear-gradient(180deg, #f8fafc, #fff); border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px; }
  .analysis-card .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .analysis-card .card-title { font-size: 11px; font-weight: 700; color: #334155; }
  .analysis-card .card-score { font-size: 24px; font-weight: 800; }
  .analysis-card .card-score.high { color: #059669; }
  .analysis-card .card-score.mid { color: #d97706; }
  .analysis-card .card-score.low { color: #dc2626; }
  .analysis-card .card-text { font-size: 11px; color: #64748b; line-height: 1.5; }
  
  /* Assessment Summary */
  .assessment-text { background: #f0f9ff; padding: 12px; border-radius: 8px; border-left: 3px solid #0ea5e9; font-size: 11px; color: #0c4a6e; line-height: 1.55; }
  
  /* Strengths & Areas */
  .feedback-section { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 14px 18px; background: #fafbfc; border-bottom: 1px solid #e5e7eb; }
  .feedback-box { border-radius: 10px; padding: 14px; }
  .feedback-box.strengths { background: linear-gradient(180deg, #ecfdf5, #d1fae5); border: 1px solid #a7f3d0; }
  .feedback-box.areas { background: linear-gradient(180deg, #fff7ed, #ffedd5); border: 1px solid #fed7aa; }
  .feedback-box h3 { font-size: 12px; font-weight: 700; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
  .feedback-box.strengths h3 { color: #065f46; }
  .feedback-box.areas h3 { color: #9a3412; }
  .feedback-list { list-style: none; }
  .feedback-list li { font-size: 11px; padding: 5px 0; border-bottom: 1px dashed rgba(0,0,0,0.08); display: flex; align-items: flex-start; gap: 6px; }
  .feedback-list li:last-child { border-bottom: none; }
  .feedback-box.strengths .feedback-list li { color: #064e3b; }
  .feedback-box.areas .feedback-list li { color: #7c2d12; }
  
  /* Performance Metrics - Horizontal 2-Column Layout */
  .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
  .metric-row { display: flex; align-items: center; gap: 10px; padding: 8px 10px; background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 6px; }
  .metric-row .name { width: 110px; font-size: 11px; color: #334155; font-weight: 600; flex-shrink: 0; }
  .metric-row .bar { flex: 1; height: 8px; background: #e5e7eb; border-radius: 4px; overflow: hidden; min-width: 60px; }
  .metric-row .bar-fill { height: 100%; border-radius: 4px; }
  .metric-row .bar-fill.high { background: linear-gradient(90deg, #10b981, #34d399); }
  .metric-row .bar-fill.mid { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
  .metric-row .bar-fill.low { background: linear-gradient(90deg, #ef4444, #f87171); }
  .metric-row .score { min-width: 32px; font-size: 13px; font-weight: 800; text-align: right; }
  .metric-row .score.high { color: #059669; }
  .metric-row .score.mid { color: #d97706; }
  .metric-row .score.low { color: #dc2626; }
  
  /* Skills Section */
  .skills-gap-box { background: linear-gradient(180deg, #fffbeb, #fef3c7); border: 1px solid #fcd34d; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; }
  .skills-gap-box h4 { font-size: 11px; font-weight: 700; color: #92400e; margin-bottom: 4px; }
  .skills-gap-box p { font-size: 10px; color: #78350f; line-height: 1.45; margin: 0; }
  
  /* Skills Table */
  .skills-table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
  .skills-table th { text-align: left; font-size: 9px; text-transform: uppercase; letter-spacing: 0.4px; color: #64748b; padding: 8px 10px; background: #f8fafc; border-bottom: 2px solid #e5e7eb; }
  .skills-table th:nth-child(3), .skills-table th:nth-child(4) { text-align: center; }
  .skills-table td { padding: 10px; border-bottom: 1px solid #f1f5f9; font-size: 11px; vertical-align: middle; }
  .skills-table tr:last-child td { border-bottom: none; }
  .skills-table .skill-name { font-weight: 600; color: #334155; }
  .skills-table .proficiency { display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 9px; font-weight: 700; text-transform: uppercase; }
  .skills-table .proficiency.high { background: #d1fae5; color: #065f46; }
  .skills-table .proficiency.mid { background: #fef3c7; color: #92400e; }
  .skills-table .proficiency.low { background: #fee2e2; color: #991b1b; }
  .skills-table .score-pill { display: inline-block; padding: 3px 8px; border-radius: 12px; font-weight: 700; font-size: 11px; }
  .skills-table .score-pill.high { background: #d1fae5; color: #059669; }
  .skills-table .score-pill.mid { background: #fef3c7; color: #d97706; }
  .skills-table .score-pill.low { background: #fee2e2; color: #dc2626; }
  .skills-table .status { text-align: center; }
  .skills-table .status-icon { width: 20px; height: 20px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; }
  .skills-table .status-icon.pass { background: #d1fae5; color: #059669; }
  .skills-table .status-icon.fail { background: #fee2e2; color: #dc2626; }
  
  /* Detailed Skill Analysis Cards */
  .skill-detail-card { padding: 10px 12px; border-radius: 8px; margin-bottom: 8px; border-left: 3px solid; }
  .skill-detail-card.high { background: #f0fdf4; border-color: #10b981; }
  .skill-detail-card.mid { background: #fffbeb; border-color: #f59e0b; }
  .skill-detail-card.low { background: #fef2f2; border-color: #ef4444; }
  .skill-detail-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
  .skill-detail-header .left { display: flex; align-items: center; gap: 6px; }
  .skill-detail-header .skill-name { font-weight: 700; font-size: 11px; color: #0f172a; }
  .skill-detail-header .level-badge { font-size: 8px; padding: 2px 5px; border-radius: 3px; font-weight: 600; }
  .skill-detail-header .level-badge.high { background: #d1fae5; color: #065f46; }
  .skill-detail-header .level-badge.mid { background: #fef3c7; color: #92400e; }
  .skill-detail-header .level-badge.low { background: #fee2e2; color: #991b1b; }
  .skill-detail-header .score { font-size: 12px; font-weight: 800; }
  .skill-detail-header .score.high { color: #059669; }
  .skill-detail-header .score.mid { color: #d97706; }
  .skill-detail-header .score.low { color: #dc2626; }
  .skill-detail-body { font-size: 10px; color: #475569; line-height: 1.45; }
  .skill-detail-body .row { margin-bottom: 3px; }
  .skill-detail-body strong { color: #334155; }
  
  /* Question Cards */
  .question-section { padding: 14px 18px; border-bottom: 1px solid #e5e7eb; }
  .question-card { border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px; margin-bottom: 12px; background: #fafbfc; }
  .question-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 8px; }
  .question-pill { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #1e3a8a; background: linear-gradient(180deg, #eef4ff, #e3edff); border: 1px solid #cfe1ff; border-radius: 20px; }
  .question-score { display: flex; align-items: baseline; gap: 4px; background: linear-gradient(180deg, #f7fbff, #e7f0ff); border: 2px solid #cfe1ff; border-radius: 8px; padding: 6px 12px; font-weight: 800; }
  .question-score .num { font-size: 20px; color: #2563eb; }
  .question-score .den { color: #64748b; font-weight: 700; font-size: 12px; }
  .question-title { font-size: 13px; font-weight: 600; color: #0f172a; margin-bottom: 10px; }
  .question-title strong { font-weight: 800; color: #1e3a8a; }
  
  .response-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px; margin-bottom: 8px; }
  .response-panel.analysis { background: #ecfdf5; border-color: #a7f3d0; }
  .response-panel h4 { font-size: 10px; text-transform: uppercase; letter-spacing: 0.4px; color: #64748b; margin-bottom: 6px; }
  .response-panel .text { font-size: 11px; line-height: 1.5; color: #334155; }
  
  /* Question Metrics Grid */
  .question-metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; margin-bottom: 10px; }
  .q-metric { display: flex; align-items: center; gap: 6px; padding: 6px 8px; background: #fff; border: 1px solid #e5e7eb; border-radius: 6px; }
  .q-metric .name { flex: 1; font-size: 10px; font-weight: 600; color: #334155; }
  .q-metric .bar { width: 40px; height: 4px; background: #e5e7eb; border-radius: 2px; overflow: hidden; }
  .q-metric .bar-fill { height: 100%; border-radius: 2px; }
  .q-metric .bar-fill.high { background: linear-gradient(90deg, #10b981, #34d399); }
  .q-metric .bar-fill.mid { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
  .q-metric .bar-fill.low { background: linear-gradient(90deg, #ef4444, #f87171); }
  .q-metric .score { font-size: 10px; font-weight: 700; min-width: 24px; text-align: right; }
  .q-metric .score.high { color: #059669; }
  .q-metric .score.mid { color: #d97706; }
  .q-metric .score.low { color: #dc2626; }
  
  /* Chips */
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { padding: 4px 8px; border-radius: 6px; font-size: 10px; font-weight: 600; }
  .chip.good { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
  .chip.bad { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
  
  /* Strengths/Weaknesses in Question */
  .sw-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .sw-box h4 { font-size: 10px; text-transform: uppercase; letter-spacing: 0.4px; color: #64748b; margin-bottom: 6px; }
  
  /* Authenticity Evidence Styles (displayed as metric row, evidence shown for medium/low) */
  .authenticity-evidence { border-radius: 8px; padding: 10px; margin-top: 8px; }
  .authenticity-evidence.high { background: linear-gradient(180deg, #fef2f2, #fee2e2); border: 1px solid #f87171; }
  .authenticity-evidence.high h4 { color: #991b1b; }
  .authenticity-evidence.high .evidence-text { color: #7c2d12; }
  .authenticity-evidence.high .observation { color: #991b1b; }
  .authenticity-evidence.medium { background: linear-gradient(180deg, #fffbeb, #fef3c7); border: 1px solid #fcd34d; }
  .authenticity-evidence.medium h4 { color: #92400e; }
  .authenticity-evidence.medium .evidence-text { color: #78350f; }
  .authenticity-evidence.medium .observation { color: #92400e; }
  .authenticity-evidence h4 { font-size: 10px; text-transform: uppercase; margin-bottom: 6px; display: flex; align-items: center; gap: 4px; }
  .authenticity-evidence .evidence-text { font-size: 11px; line-height: 1.45; }
  .authenticity-evidence .observation { padding: 4px 0; border-bottom: 1px dashed rgba(0, 0, 0, 0.1); font-size: 10px; }
  .authenticity-evidence .observation:last-child { border-bottom: none; }
  
  /* Timeline */
  .timeline-section { padding: 14px 18px; border-bottom: 1px solid #e5e7eb; }
  .timeline-header { font-size: 14px; font-weight: 700; color: #1e3a8a; text-align: center; margin-bottom: 4px; }
  .timeline-sub { font-size: 11px; color: #64748b; text-align: center; margin-bottom: 12px; }
  
  .chat { margin-top: 10px; }
  .msg { display: flex; gap: 8px; margin-bottom: 10px; }
  .msg.left { justify-content: flex-start; }
  .msg.right { justify-content: flex-end; }
  
  .bubble { max-width: 70%; border-radius: 12px; padding: 10px 12px; background: #fff; border: 1px solid #e5e7eb; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
  .msg.right .bubble { background: linear-gradient(180deg, #eaf5ff, #dff0ff); border-color: #b9ddff; }
  .bubble .who { font-size: 10px; font-weight: 700; margin-bottom: 4px; display: flex; align-items: center; gap: 6px; }
  .msg.left .bubble .who { color: #1e40af; }
  .msg.right .bubble .who { color: #0e7490; justify-content: flex-end; }
  .bubble .who img { width: 20px; height: 20px; border-radius: 50%; object-fit: cover; }
  .bubble .msg-text { font-size: 11px; line-height: 1.45; color: #0f172a; }
  .bubble .time { font-size: 9px; margin-top: 4px; color: #64748b; }
  .msg.left .bubble .time { text-align: left; }
  .msg.right .bubble .time { text-align: right; }
  
  /* Warning/Exit message styles */
  .msg.type-warning .bubble, .msg.type-video_off .bubble { background: linear-gradient(180deg, #fff3bf, #fde68a); border-color: #f59e0b; }
  .msg.type-warning .bubble .who, .msg.type-video_off .bubble .who { color: #92400e; }
  .msg.type-exit .bubble { background: linear-gradient(180deg, #fecaca, #fca5a5); border-color: #ef4444; }
  .msg.type-exit .bubble .who { color: #991b1b; }
  
  .footer { text-align: center; padding: 12px;background: linear-gradient(135deg, #93c5fd 0%, #bfdbfe 100%); color: #64748b; font-size: 10px; }
  
  /* Print styles */
  @page { size: A4; margin: 5mm; }
  @media print {
    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    body { font-size: 10px; }
    .question-card, .skill-detail-card, .msg { page-break-inside: avoid !important; break-inside: avoid !important; }
    .section-header, .question-header { page-break-after: avoid !important; }
  }
</style>
</head>
<body>
<div class="report">
  <!-- Header with Logo -->
  <div class="header">
    <div class="title-text">
      Detailed Interview Report
    </div>
    <div class="logo-box">
      <img src="./interview_reports/AIRA_LOGO.jpg" alt="AIRA Logo" />
    </div>
  </div>
  
  <!-- VERDICT BANNER -->
  <div class="verdict-banner {% if verdict.passed %}pass{% else %}fail{% endif %}">
    <div class="verdict-badge">{{ verdict.icon }}</div>
    <div class="verdict-content">
      <div class="verdict-status">{{ verdict.status }}</div>
      <div class="verdict-subtitle">
        {% set q_count = interview.questions_count|default(0)|int %}
        {% set total_q = interview.total_questions|default(15)|int %}
        {% set min_required = (total_q * 3 // 4) if (total_q * 3 // 4) >= 3 else 3 %}
        {% if q_count < min_required and not verdict.passed %}
          Interview incomplete: Minimum {{ min_required }} out of {{ total_q }} questions required to pass. Only {{ q_count }} question{{ 's' if q_count != 1 else '' }} answered.
        {% else %}
          {{ verdict.subtitle }}
        {% endif %}
      </div>
    </div>
    <div class="verdict-score-box">
      <div class="number">{{ interview_analysis.score }}</div>
      <div class="label">Overall Score</div>
    </div>
  </div>
  
  <!-- Quick Stats -->
  <div class="stats-strip">
    <div class="stat">
      <div class="value">{{ interview.questions_count if interview and interview.questions_count else '0' }}/{{ interview.total_questions if interview and interview.total_questions else '15' }}</div>
      <div class="label">Questions</div>
    </div>
    <div class="stat">
      <div class="value">{{ interview.duration if interview and interview.duration else 'N/A' }}</div>
      <div class="label">Duration</div>
    </div>
    <div class="stat">
      <div class="value">{% if mandatory_skills_evaluation and mandatory_skills_evaluation.total_skills %}{{ mandatory_skills_evaluation.skills_met }}/{{ mandatory_skills_evaluation.total_skills }}{% else %}N/A{% endif %}</div>
      <div class="label">Skills Passed</div>
    </div>
    <div class="stat">
      <div class="value">{{ interview.mode if interview and interview.mode else 'N/A' }}</div>
      <div class="label">Mode</div>
    </div>
  </div>
  
  <!-- Candidate + Interview -->
  <div class="info-section">
    <div class="info-box">
      <div class="candidate-card">
        <div class="candidate-avatar">
          {% if candidate.photo_url %}
          <img src="{{ candidate.photo_url }}" alt="Candidate Photo" />
          {% else %}
          {{ candidate.name[:2]|upper }}
          {% endif %}
        </div>
        <div class="candidate-info-wrapper">
          <div class="candidate-info-title">Candidate Details</div>
          <div class="candidate-details">
            <div class="value">{{ candidate.name }}</div>
            <div class="value">{{ candidate.email }}</div>
            <div class="value">{{ candidate.phone }}</div>
          </div>
        </div>
      </div>
    </div>
    <div class="info-box">
      <div class="title">📅 Interview Details</div>
      <div class="interview-grid">
        <div class="interview-cell company-position-cell">
          <div class="info-item">
            <div class="label">Company:</div>
            <div class="value">{{ client.company }}</div>
          </div>
          <div class="info-item">
            <div class="label">Position:</div>
            <div class="value">{{ client.position }}</div>
          </div>
        </div>
        <div class="interview-cell">
          <div class="info-item">
            <div class="label">Date:</div>
            <div class="value">{{ interview.date }}</div>
          </div>
        </div>
        <div class="interview-cell">
          <div class="info-item">
            <div class="label">Time:</div>
            <div class="value">{{ interview.time }}</div>
          </div>
        </div>
        <div class="interview-cell">
          <div class="info-item">
            <div class="label">Timezone:</div>
            <div class="value">{{ interview.timezone }}</div>
          </div>
        </div>
        <div class="interview-cell">
          <div class="info-item">
            <div class="label">Room ID:</div>
            <div class="value mono">{{ interview.room_id }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Resume & Interview Analysis Cards -->
  <div class="section">
    <div class="section-header">📊 Performance Analysis</div>
    <div class="analysis-grid">
      <div class="analysis-card">
        <div class="card-header">
          <div class="card-title">📋 Resume Analysis</div>
          <div class="card-score {% if resume_analysis.score >= 3.5 %}high{% elif resume_analysis.score >= 2 %}mid{% else %}low{% endif %}">{{ resume_analysis.score }}/5</div>
        </div>
        <div class="card-text">{{ resume_analysis.recommendation }}</div>
      </div>
      <div class="analysis-card">
        <div class="card-header">
          <div class="card-title">🎯 Interview Analysis</div>
          <div class="card-score {% if interview_analysis.score >= 3.5 %}high{% elif interview_analysis.score >= 2 %}mid{% else %}low{% endif %}">{{ interview_analysis.score }}/5</div>
        </div>
        <div class="card-text">{{ interview_analysis.recommendation }}</div>
      </div>
    </div>
  </div>
  
  <!-- Overall Assessment -->
  {% if verdict and verdict.overall_assessment %}
  <div class="section">
    <div class="section-header">📝 Overall Assessment</div>
    <div class="assessment-text">
      {{ verdict.overall_assessment }}
    </div>
  </div>
  {% endif %}
  
  <!-- Authenticity Analysis -->
  {% if authorship_analysis and authorship_analysis.authenticity_score is not none %}
  <div class="section">
    <div class="section-header">🔍 Authenticity Analysis</div>
    <div class="assessment-text" style="display: flex; gap: 16px; align-items: flex-start;">
      <div style="flex: 0 0 80px; text-align: center; padding: 12px; background: {% if authorship_analysis.authenticity_score >= 65 %}linear-gradient(180deg, #ecfdf5, #d1fae5){% elif authorship_analysis.authenticity_score >= 33 %}linear-gradient(180deg, #fefce8, #fef9c3){% else %}linear-gradient(180deg, #fef2f2, #fecaca){% endif %}; border-radius: 10px;">
        <div style="font-size: 24px; font-weight: 800; color: {% if authorship_analysis.authenticity_score >= 65 %}#059669{% elif authorship_analysis.authenticity_score >= 33 %}#ca8a04{% else %}#dc2626{% endif %};">{{ authorship_analysis.authenticity_score|round|int }}%</div>
        <div style="font-size: 9px; color: #64748b; text-transform: uppercase;">Authenticity</div>
      </div>
      <div style="flex: 1;">
        <div style="font-weight: 600; margin-bottom: 6px; color: {% if authorship_analysis.authenticity_score >= 65 %}#059669{% elif authorship_analysis.authenticity_score >= 33 %}#ca8a04{% else %}#dc2626{% endif %};">
          {% if authorship_analysis.authenticity_score >= 65 %}✓ Human-like Responses{% elif authorship_analysis.authenticity_score >= 33 %}⚡ Mixed Signals{% else %}🚨 Suspicious - Possible AI Assistance{% endif %}
        </div>
        <div style="font-size: 11px; color: #475569; line-height: 1.5;">
          {% if authorship_analysis.authenticity_score >= 65 %}
            Responses show natural speech patterns, hesitations, and filler words consistent with human communication.
          {% elif authorship_analysis.authenticity_score >= 33 %}
            Some responses appear polished while others show natural patterns. Recommend careful review if score is near threshold.
          {% else %}
            Responses appear unusually polished with minimal natural speech patterns. Combined with {% if authorship_analysis.mute_event_count >= 3 %}{{ authorship_analysis.mute_event_count }} mute events during the interview, this {% else %}detected signals, this {% endif %}warrants human review to verify authenticity.
          {% endif %}
        </div>
        {% if authorship_analysis.suspicious_count and authorship_analysis.suspicious_count > 0 %}
        <div style="margin-top: 8px; font-size: 10px; color: #991b1b; background: #fef2f2; padding: 6px 10px; border-radius: 6px; border-left: 3px solid #dc2626;">
          ⚠️ {{ authorship_analysis.suspicious_count }} answer(s) flagged as potentially AI-generated
        </div>
        {% endif %}
      </div>
    </div>
  </div>
  {% endif %}
  
  <!-- Strengths & Areas -->
  {% if verdict and verdict.strengths and verdict.areas %}
  <div class="feedback-section">
    <div class="feedback-box strengths">
      <h3>{{ verdict.strengths.title }}</h3>
      <ul class="feedback-list">
        {% for strength in verdict.strengths['items'] %}
        <li>✓ {{ strength }}</li>
        {% endfor %}
      </ul>
    </div>
    <div class="feedback-box areas">
      <h3>{{ verdict.areas.title }}</h3>
      <ul class="feedback-list">
        {% for area in verdict.areas['items'] %}
        <li>⚠ {{ area }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% endif %}
  
  <!-- Performance Metrics - Horizontal 2-Column Layout -->
  {% if overview and overview.metrics %}
  <div class="section">
    <div class="section-header">📊 Performance Metrics</div>
    <div class="metrics-grid">
      {% for metric in overview.metrics %}
      <div class="metric-row">
        <div class="name">{{ metric.name }}</div>
        <div class="bar"><div class="bar-fill {% if metric.score >= 3.5 %}high{% elif metric.score >= 2 %}mid{% else %}low{% endif %}" style="width:{{ (metric.score / 5 * 100)|round|int }}%"></div></div>
        <div class="score {% if metric.score >= 3.5 %}high{% elif metric.score >= 2 %}mid{% else %}low{% endif %}">{{ metric.score }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  
  <!-- Mandatory Skills Evaluation -->
  {% if mandatory_skills_evaluation and mandatory_skills_evaluation.mandatory_skills %}
  <div class="section">
    <div class="section-header">🎯 Mandatory Skills Evaluation</div>
    
    {% if mandatory_skills_evaluation.skills_gap_summary %}
    <div class="skills-gap-box">
      <h4>📋 Skills Gap Summary</h4>
      <p>{{ mandatory_skills_evaluation.skills_gap_summary }}</p>
    </div>
    {% endif %}
    
    <!-- Skills Summary Stats -->
    <div style="display: flex; gap: 12px; margin-bottom: 14px;">
      <div style="flex: 1; background: linear-gradient(180deg, #ecfdf5, #d1fae5); border: 1px solid #a7f3d0; border-radius: 8px; padding: 12px; text-align: center;">
        <div style="font-size: 24px; font-weight: 800; color: #059669;">{{ mandatory_skills_evaluation.skills_met }}/{{ mandatory_skills_evaluation.total_skills }}</div>
        <div style="font-size: 10px; color: #065f46; text-transform: uppercase; font-weight: 600;">Skills Passed</div>
      </div>
      <div style="flex: 1; background: linear-gradient(180deg, #f0f9ff, #e0f2fe); border: 1px solid #7dd3fc; border-radius: 8px; padding: 12px; text-align: center;">
        <div style="font-size: 24px; font-weight: 800; color: #0284c7;">{{ mandatory_skills_evaluation.overall_mandatory_score }}/5</div>
        <div style="font-size: 10px; color: #0369a1; text-transform: uppercase; font-weight: 600;">Overall Skills Score</div>
      </div>
    </div>
    
    <!-- Skills Table -->
    <table class="skills-table">
      <thead>
        <tr>
          <th>Skill</th>
          <th>Proficiency</th>
          <th>Score</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% for skill in mandatory_skills_evaluation.mandatory_skills %}
        <tr>
          <td class="skill-name">{{ skill.skill_name }}</td>
          <td><span class="proficiency {% if skill.score >= 3.5 %}high{% elif skill.score >= 2 %}mid{% else %}low{% endif %}">{{ skill.proficiency_level }}</span></td>
          <td style="text-align:center"><span class="score-pill {% if skill.score >= 3.5 %}high{% elif skill.score >= 2 %}mid{% else %}low{% endif %}">{{ skill.score }}</span></td>
          <td class="status"><span class="status-icon {% if skill.demonstrated %}pass{% else %}fail{% endif %}">{% if skill.demonstrated %}✓{% else %}✗{% endif %}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    
    <!-- Detailed Skill Analysis -->
    <div class="section-header" style="margin-top:14px;">🔍 Detailed Skill Analysis</div>
    {% for skill in mandatory_skills_evaluation.mandatory_skills %}
    <div class="skill-detail-card {% if skill.score >= 3.5 %}high{% elif skill.score >= 2 %}mid{% else %}low{% endif %}">
      <div class="skill-detail-header">
        <div class="left">
          <span>{% if skill.demonstrated %}✓{% else %}✗{% endif %}</span>
          <span class="skill-name">{{ skill.skill_name }}</span>
          <span class="level-badge {% if skill.score >= 3.5 %}high{% elif skill.score >= 2 %}mid{% else %}low{% endif %}">{{ skill.proficiency_level }}</span>
        </div>
        <span class="score {% if skill.score >= 3.5 %}high{% elif skill.score >= 2 %}mid{% else %}low{% endif %}">{{ skill.score }}/5</span>
      </div>
      <div class="skill-detail-body">
        {% if skill.questions_asked and skill.questions_asked|length > 0 %}
        <div class="row"><strong>Questions Asked:</strong> {{ skill.questions_asked|join('; ') }}</div>
        {% endif %}
        <div class="row"><strong>Evidence:</strong> {{ skill.evidence }}</div>
        <div class="row"><strong>Assessment:</strong> {{ skill.assessment }}</div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  
  <!-- Analyzed Questions Section -->
  <div class="question-section">
    <div class="section-header">📝 Analyzed Questions</div>
    <p style="font-size:11px;color:#64748b;margin-bottom:14px;">Each card includes the question, candidate's response, analysis, metrics, and feedback.</p>
    
    {% set ns = namespace(count=0) %}
    {% set total = questions.list|selectattr('flag','equalto',False)|list|length %}
    {% for item in questions.list %}
    {% if not item.flag %}
    {% set ns.count = ns.count + 1 %}
    
    <div class="question-card">
      <div class="question-header">
        <span class="question-pill">Question {{ ns.count }} / {{ total }}</span>
        <div class="question-score">
          <span class="num">{{ item.overall_score }}</span>
          <span class="den">/ 5</span>
        </div>
      </div>
      
      <div class="question-title"><strong>Q:</strong> {{ item.question }}</div>
      
      <div class="response-panel">
        <h4>💬 Candidate Response</h4>
        <div class="text">{{ item.answer }}</div>
      </div>
      
      <div class="response-panel analysis">
        <h4>🔍 System Analysis</h4>
        <div class="text">{{ item.analysis }}</div>
      </div>
      
      <!-- Question Metrics -->
      {% if item.metrics %}
      <div class="question-metrics">
        {% for metric in item.metrics %}
        <div class="q-metric">
          <div class="name">{{ metric.name }}</div>
          <div class="bar"><div class="bar-fill {% if metric.score >= 3.5 %}high{% elif metric.score >= 2 %}mid{% else %}low{% endif %}" style="width:{{ (metric.score / 5 * 100)|round|int }}%"></div></div>
          <div class="score {% if metric.score >= 3.5 %}high{% elif metric.score >= 2 %}mid{% else %}low{% endif %}">{{ metric.score }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      
      <!-- Strengths & Weaknesses -->
      <div class="sw-grid">
        <div class="sw-box">
          <h4>✅ Strengths</h4>
          <div class="chips">
            {% for strength in item.strengths %}
            <span class="chip good">{{ strength }}</span>
            {% endfor %}
            {% if item.strengths|length == 0 %}
            <span style="color:#64748b;font-size:10px;font-style:italic;">None identified</span>
            {% endif %}
          </div>
        </div>
        <div class="sw-box">
          <h4>⚠️ Areas for Improvement</h4>
          <div class="chips">
            {% for weakness in item.weaknesses %}
            <span class="chip bad">{{ weakness }}</span>
            {% endfor %}
            {% if item.weaknesses|length == 0 %}
            <span style="color:#64748b;font-size:10px;font-style:italic;">None identified</span>
            {% endif %}
          </div>
        </div>
      </div>
      {# Per-question authenticity evidence removed - shown in Authenticity Analysis section instead #}
    </div>
    {% endif %}
    {% endfor %}
  </div>
  
  <!-- Conversation Timeline -->
  {% if questions.conversation_timeline and questions.conversation_timeline|length > 0 %}
  <div class="timeline-section">
    <div class="timeline-header">💬 Conversation Timeline</div>
    <div class="timeline-sub">Chronological transcript of the interview</div>
    
    <div class="chat">
      {% for timeline_item in questions.conversation_timeline %}
        {% if timeline_item.aira_said %}
        <div class="msg left {% if timeline_item.conversation_type %}type-{{ timeline_item.conversation_type }}{% endif %}">
          <div class="bubble">
            <div class="who">
              <img src="./interview_reports/Aira_bot.jpg" alt="AIRA" /> AIRA
            </div>
            <div class="msg-text">{{ timeline_item.aira_said }}</div>
            <div class="time">{{ timeline_item.timestamp }}</div>
          </div>
        </div>
        {% endif %}
        
        {% if timeline_item.candidate_said %}
        <div class="msg right">
          <div class="bubble">
            <div class="who">
              {{ candidate.name }}
              {% if candidate.photo_url %}<img src="{{ candidate.photo_url }}" alt="{{ candidate.name }}">{% endif %}
            </div>
            <div class="msg-text">{{ timeline_item.candidate_said }}</div>
            <div class="time">{{ timeline_item.timestamp }}</div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
  
  <div class="footer">{{ footer.text }}</div>
</div>
</body>
</html>
