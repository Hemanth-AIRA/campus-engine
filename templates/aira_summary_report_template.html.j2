<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>AIRA - Interview Report</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', system-ui, sans-serif; background: #fff; padding: 0; font-size: 12px; line-height: 1.4; }
  .report { max-width: 100%; margin: 0; background: #fff; }
  
  /* Header with Logo */
  .header { background: linear-gradient(135deg, #93c5fd 0%, #bfdbfe 100%); padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; }
  .header .title-text { color: #000; font-size: 18px; font-weight: 700; line-height: 1.4; max-width: 60%; }
  .header .title-text .role { font-weight: 800; color: #0f172a; }
  .header .title-text .company { font-weight: 700; color: #1e3a8a; }
  .logo-box { background: #fff; padding: 10px 16px; border-radius: 8px; height: 60px; display: flex; align-items: center; }
  .logo-box img { height: 44px; display: block; }
  
  /* VERDICT BANNER */
  .verdict-banner { padding: 18px 20px; display: flex; align-items: center; gap: 16px; }
  .verdict-banner.pass { background: linear-gradient(135deg, #059669 0%, #10b981 50%, #34d399 100%); }
  .verdict-banner.fail { background: #fca5a5; padding: 14px 20px; }
  .verdict-badge { width: 56px; height: 56px; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; flex-shrink: 0; color: #fca5a5; }
  .verdict-content { flex: 1; color: #000; }
  .verdict-status { font-size: 20px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
  .verdict-subtitle { font-size: 12px; opacity: 0.9; margin-top: 2px; }
  .verdict-score-box { text-align: center; background: #fff; border-radius: 8px; padding: 8px 12px; }
  .verdict-score-box .number { font-size: 26px; font-weight: 800; color: #fca5a5; }
  .verdict-score-box .label { font-size: 8px; color: #000; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
  
  /* Quick Stats Strip */
  .stats-strip { display: grid; grid-template-columns: 25% 25% 25% 25%; background: #f8fafc; border-bottom: 1px solid #e5e7eb; }
  .stat { padding: 12px 8px; text-align: center; border-right: 1px solid #e5e7eb; }
  .stat:last-child { border-right: none; }
  .stat .value { font-size: 18px; font-weight: 800; color: #1e3a8a; }
  .stat .label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.3px; color: #64748b; margin-top: 2px; }
  
  /* Candidate + Interview Row */
  .info-section { display: grid; grid-template-columns: 50% 50%; border-bottom: 1px solid #e5e7eb; }
  .info-box { padding: 14px 18px 8px 18px ; }
  .info-box:first-child { border-right: 1px solid #e5e7eb; }
  .info-box .title { font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: #1e3a8a; font-weight: 700; margin-bottom: 10px; }
  
  /* Updated Candidate Card Layout */
  .candidate-card { display: flex; gap: 16px; align-items: stretch; }
  .candidate-avatar { 
    width: 200px; 
    height: 200px; 
    min-width: 200px;
    border-radius: 12px; 
    background: linear-gradient(135deg, #1e3a8a, #3b82f6); 
    color: #fff; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    font-size: 72px; 
    font-weight: 700; 
    flex-shrink: 0; 
    overflow: hidden; 
  }
  .candidate-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .candidate-info-wrapper { 
    flex: 1; 
    display: flex; 
    flex-direction: column; 
    gap: 8px;
    min-height: 200px;
    margin-top: 50px;
  }
  .candidate-info-title { 
    font-size: 10px; 
    text-transform: uppercase; 
    letter-spacing: 0.5px; 
    color: #1e3a8a; 
    font-weight: 700; 
    margin-bottom: 8px; 
  }
  .candidate-details { 
    background: #f8fafc; 
    padding: 10px 12px; 
    border-radius: 6px; 
    margin-bottom: 6px;
  }
  .candidate-details .name { font-size: 12px; font-weight: 700; color: #0f172a; margin-bottom: 6px; }
  .candidate-details .email { font-size: 10px; color: #64748b; margin-top: 3px; }
  .candidate-details .phone { font-size: 10px; color: #64748b; margin-top: 3px; }
  .candidate-details .label { font-size: 9px; text-transform: uppercase; color: #94a3b8; font-weight: 600; margin-bottom: 2px; }
  .candidate-details .value { font-size: 11px; font-weight: 600; color: #334155; }
  .candidate-details .position-tag { display: inline-block; background: #e0e7ff; color: #3730a3; padding: 4px 10px; border-radius: 4px; font-size: 10px; font-weight: 600; margin-top: 8px; }
  .company-box { 
    background: linear-gradient(135deg, #f8fafc, #f1f5f9); 
    border: 1px solid #e2e8f0; 
    border-radius: 8px; 
    padding: 10px 12px; 
    margin-top: auto;
  }
  .company-box .company-label { font-size: 9px; text-transform: uppercase; color: #64748b; font-weight: 600; margin-bottom: 3px; }
  .company-box .company-name { font-size: 13px; font-weight: 700; color: #0f172a; display: flex; align-items: center; gap: 6px; }
  
 .interview-grid { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 8px; 
  }
  .interview-cell { 
    background: #f8fafc; 
    padding: 8px 10px; 
    border-radius: 6px; 
  }
  .interview-cell.wide { grid-column: span 2; }
  .interview-cell .value.mono { font-family: monospace; font-size: 10px; }
  .interview-cell.company-position-cell { 
    grid-column: 1 / -1;  /* Span full width - row 1 */
    display: flex; 
    flex-direction: column; 
    gap: 12px; 
  }
  .interview-cell .info-item { 
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .interview-cell .info-item .label { 
    font-size: 9px; 
    text-transform: uppercase; 
    color: #94a3b8; 
    font-weight: 600;
    margin-bottom: 0;
    white-space: nowrap;
  }
  .interview-cell .info-item .value { 
    font-size: 11px; 
    font-weight: 600; 
    color: #334155;
    margin-top: 0;
  }

  /* Assessment Summary */
  .assessment-section { padding: 14px 18px; border-bottom: 1px solid #e5e7eb; }
  .section-header { font-size: 12px; font-weight: 700; color: #1e3a8a; margin-bottom: 10px; }
  .assessment-text { background: #f0f9ff; padding: 12px; border-radius: 8px; border-left: 3px solid #0ea5e9; font-size: 11px; color: #0c4a6e; line-height: 1.55; }
  
  /* Strengths & Areas */
  .feedback-section { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 14px 18px; background: #fafbfc; border-bottom: 1px solid #e5e7eb; }
  .feedback-box { border-radius: 10px; padding: 14px; }
  .feedback-box.strengths { background: linear-gradient(180deg, #ecfdf5, #d1fae5); border: 1px solid #a7f3d0; }
  .feedback-box.areas { background: linear-gradient(180deg, #fff7ed, #ffedd5); border: 1px solid #fed7aa; }
  .feedback-box h3 { font-size: 12px; font-weight: 700; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
  .feedback-box.strengths h3 { color: #065f46; }
  .feedback-box.areas h3 { color: #9a3412; }
  .feedback-list { list-style: none; }
  .feedback-list li { font-size: 11px; padding: 5px 0; border-bottom: 1px dashed rgba(0,0,0,0.08); display: flex; align-items: flex-start; gap: 6px; }
  .feedback-list li:last-child { border-bottom: none; }
  .feedback-box.strengths .feedback-list li { color: #064e3b; }
  .feedback-box.areas .feedback-list li { color: #7c2d12; }
  
  /* Performance Metrics - Horizontal 2-Column Layout */
  .metrics-section { padding: 14px 18px; border-bottom: 1px solid #e5e7eb; }
  .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
  .metric-row { display: flex; align-items: center; gap: 10px; padding: 8px 10px; background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 6px; }
  .metric-row .name { width: 110px; font-size: 11px; color: #334155; font-weight: 600; flex-shrink: 0; }
  .metric-row .bar { flex: 1; height: 8px; background: #e5e7eb; border-radius: 4px; overflow: hidden; min-width: 60px; }
  .metric-row .bar-fill { height: 100%; border-radius: 4px; }
  .metric-row .bar-fill.high { background: linear-gradient(90deg, #10b981, #34d399); }
  .metric-row .bar-fill.mid { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
  .metric-row .bar-fill.low { background: linear-gradient(90deg, #ef4444, #f87171); }
  .metric-row .score { min-width: 32px; font-size: 13px; font-weight: 800; text-align: right; }
  .metric-row .score.high { color: #059669; }
  .metric-row .score.mid { color: #d97706; }
  .metric-row .score.low { color: #dc2626; }
  
  /* Skills Section */
  .skills-section { padding: 14px 18px; border-bottom: 1px solid #e5e7eb; }
  
  .skills-gap-box { background: linear-gradient(180deg, #fffbeb, #fef3c7); border: 1px solid #fcd34d; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; }
  .skills-gap-box h4 { font-size: 11px; font-weight: 700; color: #92400e; margin-bottom: 4px; }
  .skills-gap-box p { font-size: 10px; color: #78350f; line-height: 1.45; margin: 0; }
  
  /* Skills Table */
  .skills-table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
  .skills-table th { text-align: left; font-size: 9px; text-transform: uppercase; letter-spacing: 0.4px; color: #64748b; padding: 8px 10px; background: #f8fafc; border-bottom: 2px solid #e5e7eb; }
  .skills-table th:nth-child(3), .skills-table th:nth-child(4) { text-align: center; }
  .skills-table td { padding: 10px; border-bottom: 1px solid #f1f5f9; font-size: 11px; vertical-align: middle; }
  .skills-table tr:last-child td { border-bottom: none; }
  .skills-table .skill-name { font-weight: 600; color: #334155; }
  .skills-table .proficiency { display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 9px; font-weight: 700; text-transform: uppercase; }
  .skills-table .proficiency.high { background: #d1fae5; color: #065f46; }
  .skills-table .proficiency.mid { background: #fef3c7; color: #92400e; }
  .skills-table .proficiency.low { background: #fee2e2; color: #991b1b; }
  .skills-table .score-pill { display: inline-block; padding: 3px 8px; border-radius: 12px; font-weight: 700; font-size: 11px; }
  .skills-table .score-pill.high { background: #d1fae5; color: #059669; }
  .skills-table .score-pill.mid { background: #fef3c7; color: #d97706; }
  .skills-table .score-pill.low { background: #fee2e2; color: #dc2626; }
  .skills-table .status { text-align: center; }
  .skills-table .status-icon { width: 20px; height: 20px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; }
  .skills-table .status-icon.pass { background: #d1fae5; color: #059669; }
  .skills-table .status-icon.fail { background: #fee2e2; color: #dc2626; }
  
  /* Authenticity & Red Flags */
  .auth-section { padding: 14px 18px; border-bottom: 1px solid #e5e7eb; }
  .auth-table { width: 100%; border-collapse: collapse; }
  .auth-table td { padding: 10px 14px; font-size: 11px; border-bottom: 1px solid #f1f5f9; }
  .auth-table td:first-child { font-weight: 600; color: #334155; width: 55%; }
  .auth-table td:last-child { text-align: right; font-weight: 700; color: #0f172a; }
  .auth-table tr.flagged td { background: #fef2f2; color: #991b1b; }
  .auth-table tr.flagged td:last-child { color: #dc2626; }
  .auth-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 9px; font-weight: 700; text-transform: uppercase; margin-left: 6px; }
  .auth-badge.pass { background: #d1fae5; color: #065f46; }
  .auth-badge.fail { background: #fee2e2; color: #991b1b; }

  .footer { text-align: center; padding: 12px; background: linear-gradient(135deg, #93c5fd 0%, #bfdbfe 100%); color: #64748b; font-size: 10px; }
</style>
</head>
<body>
<div class="report">
  <!-- Header with Logo -->
  <div class="header">
    <div class="title-text">
      Interview Summary Report
    </div>
    <div class="logo-box">
      <img src="./interview_reports/AIRA_LOGO.jpg" alt="AIRA Logo" />
    </div>
  </div>
  
  <!-- VERDICT BANNER -->
  <div class="verdict-banner {% if verdict.passed %}pass{% else %}fail{% endif %}">
    <div class="verdict-badge">{{ verdict.icon }}</div>
    <div class="verdict-content">
      <div class="verdict-status">{{ verdict.status }}</div>
      <div class="verdict-subtitle">
        {% set q_count = interview.questions_count|default(0)|int %}
        {% set total_q = interview.total_questions|default(15)|int %}
        {% set min_required = (total_q * 3 // 4) if (total_q * 3 // 4) >= 3 else 3 %}
        {% if q_count < min_required and not verdict.passed %}
          Interview incomplete: Minimum {{ min_required }} out of {{ total_q }} questions required to pass. Only {{ q_count }} question{{ 's' if q_count != 1 else '' }} answered.
        {% else %}
          {{ verdict.subtitle }}
        {% endif %}
      </div>
    </div>
    <div class="verdict-score-box">
      <div class="number">{{ interview_analysis.score }}</div>
      <div class="label">Overall Score</div>
    </div>
  </div>
  
  <!-- Quick Stats -->
  <div class="stats-strip">
    <div class="stat">
      <div class="value">{{ interview.questions_count if interview and interview.questions_count else '0' }}/{{ interview.total_questions if interview and interview.total_questions else '15' }}</div>
      <div class="label">Questions</div>
    </div>
    <div class="stat">
      <div class="value">{{ interview.duration if interview and interview.duration else 'N/A' }}</div>
      <div class="label">Duration</div>
    </div>
    <div class="stat">
      <div class="value">{% if mandatory_skills_evaluation and mandatory_skills_evaluation.total_skills %}{{ mandatory_skills_evaluation.skills_met }}/{{ mandatory_skills_evaluation.total_skills }}{% else %}N/A{% endif %}</div>
      <div class="label">Skills Passed</div>
    </div>
    <div class="stat">
      <div class="value">{{ interview.mode if interview and interview.mode else 'N/A' }}</div>
      <div class="label">Mode</div>
    </div>
  </div>
  
  <!-- Candidate + Interview -->
  <div class="info-section">
    <div class="info-box">
      <div class="candidate-card">
        <div class="candidate-avatar">
          {% if candidate.photo_url %}
          <img src="{{ candidate.photo_url }}" alt="Candidate Photo" />
          {% else %}
          {{ candidate.name[:2]|upper }}
          {% endif %}
        </div>
        <div class="candidate-info-wrapper">
          <div class="candidate-info-title">Candidate Details</div>
          <div class="candidate-details">
            <div class="value">{{ candidate.name }}</div>
            <div class="value">{{ candidate.email }}</div>
            <div class="value">{{ candidate.phone }}</div>
          </div>
        </div>
      </div>
    </div>
    <div class="info-box">
      <div class="title">📅 Interview Details</div>
      <div class="interview-grid">
        <div class="interview-cell company-position-cell">
          <div class="info-item">
            <div class="label">Company:</div>
            <div class="value">{{ client.company }}</div>
          </div>
          <div class="info-item">
            <div class="label">Position:</div>
            <div class="value">{{ client.position }}</div>
          </div>
        </div>
        <div class="interview-cell">
          <div class="info-item">
            <div class="label">Date:</div>
            <div class="value">{{ interview.date }}</div>
          </div>
        </div>
        <div class="interview-cell">
          <div class="info-item">
            <div class="label">Time:</div>
            <div class="value">{{ interview.time }}</div>
          </div>
        </div>
        <div class="interview-cell">
          <div class="info-item">
            <div class="label">Timezone:</div>
            <div class="value">{{ interview.timezone }}</div>
          </div>
        </div>
        <div class="interview-cell">
          <div class="info-item">
            <div class="label">Room ID:</div>
            <div class="value mono">{{ interview.room_id }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Assessment -->
  {% if verdict and verdict.overall_assessment %}
  <div class="assessment-section">
    <div class="section-header">📊 Overall Assessment</div>
    <div class="assessment-text">
      {{ verdict.overall_assessment }}
    </div>
  </div>
  {% endif %}
  
  <!-- Strengths & Areas -->
  {% if verdict and verdict.strengths and verdict.areas %}
  <div class="feedback-section">
    <div class="feedback-box strengths">
      <h3>{{ verdict.strengths.title }}</h3>
      <ul class="feedback-list">
        {% for strength in verdict.strengths['items'] %}
        <li>✓ {{ strength }}</li>
        {% endfor %}
      </ul>
    </div>
    <div class="feedback-box areas">
      <h3>{{ verdict.areas.title }}</h3>
      <ul class="feedback-list">
        {% for area in verdict.areas['items'] %}
        <li>⚠ {{ area }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% endif %}
  
  <!-- Performance Metrics - Horizontal 2-Column Layout -->
  {% if overview and overview.metrics %}
  <div class="metrics-section">
    <div class="section-header">📊 Performance Metrics</div>
    <div class="metrics-grid">
      {% for metric in overview.metrics %}
      <div class="metric-row">
        <div class="name">{{ metric.name }}</div>
        <div class="bar"><div class="bar-fill {% if metric.score >= 3.5 %}high{% elif metric.score >= 2 %}mid{% else %}low{% endif %}" style="width:{{ (metric.score / 5 * 100)|round|int }}%"></div></div>
        <div class="score {% if metric.score >= 3.5 %}high{% elif metric.score >= 2 %}mid{% else %}low{% endif %}">{{ metric.score }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  
  <!-- Skills Section -->
  {% if mandatory_skills_evaluation and mandatory_skills_evaluation.mandatory_skills %}
  <div class="skills-section">
    <div class="section-header">🎯 Skills Tested During Interview</div>
    
    <div class="skills-gap-box">
      <h4>📋 Skills Gap Summary</h4>
      <p>{{ mandatory_skills_evaluation.skills_gap_summary }}</p>
    </div>
    
    <table class="skills-table">
      <thead>
        <tr>
          <th>Skill</th>
          <th>Proficiency</th>
          <th>Score</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% for skill in mandatory_skills_evaluation.mandatory_skills %}
        <tr>
          <td class="skill-name">{{ skill.skill_name }}</td>
          <td><span class="proficiency {% if skill.score >= 3.5 %}high{% elif skill.score >= 2 %}mid{% else %}low{% endif %}">{{ skill.proficiency_level }}</span></td>
          <td style="text-align:center"><span class="score-pill {% if skill.score >= 3.5 %}high{% elif skill.score >= 2 %}mid{% else %}low{% endif %}">{{ skill.score }}</span></td>
          <td class="status"><span class="status-icon {% if skill.demonstrated %}pass{% else %}fail{% endif %}">{% if skill.demonstrated %}✓{% else %}✗{% endif %}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  
  <!-- Authenticity & Red Flags -->
  {% if behavioral_metrics is defined %}
  <div class="auth-section">
    <div class="section-header">🛡️ Authenticity & Red Flags</div>
    <table class="auth-table">
      {% if behavioral_metrics.authenticity_score is not none %}
      {% set auth_flag = behavioral_metrics.authenticity_score < 50 %}
      <tr{% if auth_flag %} class="flagged"{% endif %}>
        <td>Authenticity Score <span class="auth-badge {% if auth_flag %}fail{% else %}pass{% endif %}">{% if auth_flag %}⚠️ RED FLAG{% else %}✓ PASS{% endif %}</span></td>
        <td>{{ behavioral_metrics.authenticity_score }}%</td>
      </tr>
      {% endif %}
      {% set tabs_flag = behavioral_metrics.tabs_switched > 2 %}
      <tr{% if tabs_flag %} class="flagged"{% endif %}>
        <td>Tabs Switched <span class="auth-badge {% if tabs_flag %}fail{% else %}pass{% endif %}">{% if tabs_flag %}⚠️ RED FLAG{% else %}✓ PASS{% endif %}</span></td>
        <td>{{ behavioral_metrics.tabs_switched }} time{{ 's' if behavioral_metrics.tabs_switched != 1 else '' }}</td>
      </tr>
      {% set swap_flag = behavioral_metrics.face_swaps_detected > 2 %}
      <tr{% if swap_flag %} class="flagged"{% endif %}>
        <td>Face Swaps Detected <span class="auth-badge {% if swap_flag %}fail{% else %}pass{% endif %}">{% if swap_flag %}⚠️ RED FLAG{% else %}✓ PASS{% endif %}</span></td>
        <td>{{ behavioral_metrics.face_swaps_detected }} time{{ 's' if behavioral_metrics.face_swaps_detected != 1 else '' }}</td>
      </tr>
      {% set multi_flag = behavioral_metrics.multiple_faces_detected > 2 %}
      <tr{% if multi_flag %} class="flagged"{% endif %}>
        <td>Multiple Faces Detected <span class="auth-badge {% if multi_flag %}fail{% else %}pass{% endif %}">{% if multi_flag %}⚠️ RED FLAG{% else %}✓ PASS{% endif %}</span></td>
        <td>{{ behavioral_metrics.multiple_faces_detected }} time{{ 's' if behavioral_metrics.multiple_faces_detected != 1 else '' }}</td>
      </tr>
      {% if behavioral_metrics.sentinel_score is not none %}
      {% set sentinel_flag = behavioral_metrics.sentinel_score < 50 %}
      <tr{% if sentinel_flag %} class="flagged"{% endif %}>
        <td>Sentinel Security Score <span class="auth-badge {% if sentinel_flag %}fail{% else %}pass{% endif %}">{% if sentinel_flag %}⚠️ RED FLAG{% else %}✓ PASS{% endif %}</span></td>
        <td>{{ behavioral_metrics.sentinel_score }}%</td>
      </tr>
      {% endif %}
    </table>
  </div>
  {% endif %}

  <div class="footer">{{ footer.text }}</div>
</div>
</body>
</html>
